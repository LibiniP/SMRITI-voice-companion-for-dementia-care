# Copy this file to .env and fill in your key. Never commit .env.
GNANI_API_KEY=your_key_here

# Speech-to-text (Prisma v3.0 can auto-detect language with language_code=indic-auto)
STT_MODEL=prisma-v3.0

# Text-to-speech. v3.0 voices speak all 10 languages. If your account only has v2.5,
# the code automatically falls back to the fallback model/voice below.
TTS_MODEL=timbre-v3.0
TTS_VOICE=Shivani
TTS_FALLBACK_MODEL=timbre-v2.5
TTS_FALLBACK_VOICE=Nalini
TTS_SPEED=0.9

# Ask a thirsty / hungry / "is anything bothering you" question every N replies (0 = never)
CHECKIN_EVERY=3

EMERGENCY_NUMBER=112
SEED_DEMO_DATA=1
